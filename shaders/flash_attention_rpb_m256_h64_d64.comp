#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_subgroup_extended_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

const uint TILE_M = 16;
const uint TILE_N = 16;
const uint TILE_K = 16;

#define MatA coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseB>
#define MatB coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseA>
#define MatAcc                                                                 \
  coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer QKV {
  f16vec4 buffer_qkv[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer RPBWeight {
  float16_t buffer_rpb_weight[];
};

layout(std430, set = 0, binding = 2) writeonly restrict buffer Out {
  f16vec4 buffer_out[];
};

shared f16vec4 k_lds[64][16];
shared f16vec4 v_lds[64][16];
shared float rpb_lut[32];

uint t5_rpb_bucket(const int diff) {
  const uint is_pos = (diff > 0) ? 16u : 0u;
  const uint rel = uint(abs(diff));
  if (rel < 8u) {
    return is_pos + rel;
  }
  const uint b = 8u + uint(log2(float(rel) * 0.125f) * 2.0f);
  return is_pos + min(b, 15u);
}

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint wave_id = tid >> 5u;
  const uint lane_mod16 = tid & 15u;
  const uint lane_half = (tid >> 4u) & 1u;
  const uint block_m = gl_WorkGroupID.x;
  const uint head_idx = gl_WorkGroupID.y;
  const uint q_block_row = block_m << 6u;
  const uint head_v4_off = head_idx << 4u;
  const float16_t q_scale = float16_t(1.44269504hf);
  if (tid < 32u) {
    rpb_lut[tid] =
        float(buffer_rpb_weight[(tid << 6u) + head_idx]) * 1.44269504f;
  }
  uint k_idx = 3072u * (tid >> 3u) + 1024u + head_v4_off + ((tid & 7u) << 1u);
  const uint v_row_in_tile = (tid >> 2u) & ~3u;
  const uint v_col_off = 2048u + head_v4_off + lane_mod16;
  uint v_idx = 3072u * v_row_in_tile + v_col_off;
  {
    const uint c_pair = tid & 7u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
      const uint r = (tid >> 3u) + (i << 4u);
      const uint global_r = q_block_row + r;
      const uint c_swz = (c_pair ^ r & 7u) << 1u;
      const uint q_off = 3072u * global_r + head_v4_off + (c_pair << 1u);
      k_lds[r][c_swz] = buffer_qkv[q_off] * q_scale;
      k_lds[r][c_swz + 1u] = buffer_qkv[q_off + 1u] * q_scale;
    }
  }
  barrier();
  MatA q_frag[4];
  [[unroll]] for (uint j = 0u; j < 4u; ++j) {
    const uint r = (wave_id << 4u) + lane_mod16;
    const uint c_base = j << 1u;
    const uint c0 = (c_base ^ r & 7u) << 1u;
    const uint c1 = (c_base + 1u ^ r & 7u) << 1u;
    const f16vec4 a0 = k_lds[r][c0];
    const f16vec4 a1 = k_lds[r][c0 + 1u];
    const f16vec4 a2 = k_lds[r][c1];
    const f16vec4 a3 = k_lds[r][c1 + 1u];
    q_frag[j][0] = a0.x;
    q_frag[j][1] = a0.y;
    q_frag[j][2] = a0.z;
    q_frag[j][3] = a0.w;
    q_frag[j][4] = a1.x;
    q_frag[j][5] = a1.y;
    q_frag[j][6] = a1.z;
    q_frag[j][7] = a1.w;
    q_frag[j][8] = a2.x;
    q_frag[j][9] = a2.y;
    q_frag[j][10] = a2.z;
    q_frag[j][11] = a2.w;
    q_frag[j][12] = a3.x;
    q_frag[j][13] = a3.y;
    q_frag[j][14] = a3.z;
    q_frag[j][15] = a3.w;
  }
  barrier();
  {
    const uint c = tid & 7u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
      const uint r = (tid >> 3u) + (i << 4u);
      const uint c_swz = (c ^ r & 7u) << 1u;
      const uint k_off = k_idx + 49152u * i;
      k_lds[r][c_swz] = buffer_qkv[k_off];
      k_lds[r][c_swz + 1u] = buffer_qkv[k_off + 1u];
    }
    const uint d_base = lane_mod16 << 2u;
    [[unroll]] for (uint i = 0u; i < 2u; ++i) {
      const uint r_v4 = (i << 3u) + (tid >> 4u);
      const uint v_off = v_idx + 98304u * i;
      const f16vec4 v0 = buffer_qkv[v_off];
      const f16vec4 v1 = buffer_qkv[v_off + 3072u];
      const f16vec4 v2 = buffer_qkv[v_off + 6144u];
      const f16vec4 v3 = buffer_qkv[v_off + 9216u];
      const uint s_base = r_v4 ^ (d_base & 15u) ^ (d_base >> 4u);
      v_lds[d_base][s_base] = f16vec4(v0.x, v1.x, v2.x, v3.x);
      v_lds[d_base + 1u][s_base ^ 1u] = f16vec4(v0.y, v1.y, v2.y, v3.y);
      v_lds[d_base + 2u][s_base ^ 2u] = f16vec4(v0.z, v1.z, v2.z, v3.z);
      v_lds[d_base + 3u][s_base ^ 3u] = f16vec4(v0.w, v1.w, v2.w, v3.w);
    }
  }
  barrier();
  f16vec4 k_prefetch[4][2];
  f16vec4 v_prefetch[2][4];
  MatA p_frag[4];
  MatB b_frag;
  MatAcc s_frag[4];
  MatAcc o_frag[4];
  [[unroll]] for (uint l = 0u; l < 4u; ++l)
    o_frag[l] = MatAcc(0.0);
  float row_max = -1e30f;
  float row_sum = 0.0f;
  const int rpb_q_idx = int(q_block_row + (wave_id << 4u) + lane_mod16);
  for (uint i = 0u; i < 256u; i += 64u) {
    const bool next = i + 64u < 256u;
    if (next) {
      [[unroll]] for (uint j = 0u; j < 4u; ++j) {
        const uint k_off = k_idx + 49152u * j + 196608u;
        k_prefetch[j][0] = buffer_qkv[k_off];
        k_prefetch[j][1] = buffer_qkv[k_off + 1u];
      }
      [[unroll]] for (uint j = 0u; j < 2u; ++j) {
        const uint v_off = v_idx + 98304u * j + 196608u;
        v_prefetch[j][0] = buffer_qkv[v_off];
        v_prefetch[j][1] = buffer_qkv[v_off + 3072u];
        v_prefetch[j][2] = buffer_qkv[v_off + 6144u];
        v_prefetch[j][3] = buffer_qkv[v_off + 9216u];
      }
    }
    [[unroll]] for (uint l = 0u; l < 4u; ++l)
      s_frag[l] = MatAcc(0.0);
    const uint k_lane = ((lane_mod16 & 1u) << 3u) | (lane_mod16 >> 1u);
    [[unroll]] for (uint j = 0u; j < 4u; ++j) {
      const uint c_base = j << 1u;
      [[unroll]] for (uint l = 0u; l < 4u; ++l) {
        const uint r = (l << 4u) + k_lane;
        const uint c0 = (c_base ^ r & 7u) << 1u;
        const uint c1 = (c_base + 1u ^ r & 7u) << 1u;
        const f16vec4 b0 = k_lds[r][c0];
        const f16vec4 b1 = k_lds[r][c0 + 1u];
        const f16vec4 b2 = k_lds[r][c1];
        const f16vec4 b3 = k_lds[r][c1 + 1u];
        b_frag[0] = b0.x;
        b_frag[1] = b0.y;
        b_frag[2] = b0.z;
        b_frag[3] = b0.w;
        b_frag[4] = b1.x;
        b_frag[5] = b1.y;
        b_frag[6] = b1.z;
        b_frag[7] = b1.w;
        b_frag[8] = b2.x;
        b_frag[9] = b2.y;
        b_frag[10] = b2.z;
        b_frag[11] = b2.w;
        b_frag[12] = b3.x;
        b_frag[13] = b3.y;
        b_frag[14] = b3.z;
        b_frag[15] = b3.w;
        s_frag[l] = coopMatMulAdd(b_frag, q_frag[j], s_frag[l]);
      }
    }
    const int rpb_k_base = int(i + (lane_half << 3u));
    [[unroll]] for (uint l = 0u; l < 4u; ++l) {
      const int k_col = rpb_k_base + int(l << 4u);
      [[unroll]] for (uint e = 0u; e < 8u; ++e) {
        s_frag[l][e] += rpb_lut[t5_rpb_bucket(k_col + int(e) - rpb_q_idx)];
      }
    }
    float local_max = row_max;
    [[unroll]] for (uint l = 0u; l < 4u; ++l) [[unroll]]
      for (uint e = 0u; e < 8u; ++e)
        local_max = max(local_max, s_frag[l][e]);
    const float new_max = max(local_max, subgroupShuffleXor(local_max, 16u));
    const float scale_old = exp2(row_max - new_max);
    row_max = new_max;
    [[unroll]] for (uint l = 0u; l < 4u; ++l) [[unroll]]
      for (uint e = 0u; e < 8u; ++e)
        o_frag[l][e] *= scale_old;
    float local_sum = 0.0f;
    [[unroll]] for (uint l = 0u; l < 4u; ++l) {
      const vec4 p_lo =
          exp2(vec4(s_frag[l][0], s_frag[l][1], s_frag[l][2], s_frag[l][3]) -
               new_max);
      const vec4 p_hi =
          exp2(vec4(s_frag[l][4], s_frag[l][5], s_frag[l][6], s_frag[l][7]) -
               new_max);
      local_sum += (p_lo.x + p_lo.y) + (p_lo.z + p_lo.w) + (p_hi.x + p_hi.y) +
                   (p_hi.z + p_hi.w);
      const f16vec4 fp16_my_lo = f16vec4(p_lo);
      const f16vec4 fp16_my_hi = f16vec4(p_hi);
      const f16vec4 fp16_other_lo = subgroupShuffleXor(fp16_my_lo, 16u);
      const f16vec4 fp16_other_hi = subgroupShuffleXor(fp16_my_hi, 16u);
      const f16vec4 a0 = (lane_half == 0u) ? fp16_my_lo : fp16_other_lo;
      const f16vec4 a1 = (lane_half == 0u) ? fp16_my_hi : fp16_other_hi;
      const f16vec4 a2 = (lane_half == 0u) ? fp16_other_lo : fp16_my_lo;
      const f16vec4 a3 = (lane_half == 0u) ? fp16_other_hi : fp16_my_hi;
      p_frag[l][0] = a0.x;
      p_frag[l][1] = a0.y;
      p_frag[l][2] = a0.z;
      p_frag[l][3] = a0.w;
      p_frag[l][4] = a1.x;
      p_frag[l][5] = a1.y;
      p_frag[l][6] = a1.z;
      p_frag[l][7] = a1.w;
      p_frag[l][8] = a2.x;
      p_frag[l][9] = a2.y;
      p_frag[l][10] = a2.z;
      p_frag[l][11] = a2.w;
      p_frag[l][12] = a3.x;
      p_frag[l][13] = a3.y;
      p_frag[l][14] = a3.z;
      p_frag[l][15] = a3.w;
    }
    row_sum =
        fma(row_sum, scale_old, local_sum + subgroupShuffleXor(local_sum, 16u));
    const uint v_lane = ((lane_mod16 & 1u) << 3u) | (lane_mod16 >> 1u);
    [[unroll]] for (uint j = 0u; j < 4u; ++j) {
      const uint r_v4_base = j << 2u;
      [[unroll]] for (uint l = 0u; l < 4u; ++l) {
        const uint d = (l << 4u) + v_lane;
        const uint s_base = r_v4_base ^ v_lane ^ l;
        const f16vec4 b0 = v_lds[d][s_base];
        const f16vec4 b1 = v_lds[d][s_base ^ 1u];
        const f16vec4 b2 = v_lds[d][s_base ^ 2u];
        const f16vec4 b3 = v_lds[d][s_base ^ 3u];
        b_frag[0] = b0.x;
        b_frag[1] = b0.y;
        b_frag[2] = b0.z;
        b_frag[3] = b0.w;
        b_frag[4] = b1.x;
        b_frag[5] = b1.y;
        b_frag[6] = b1.z;
        b_frag[7] = b1.w;
        b_frag[8] = b2.x;
        b_frag[9] = b2.y;
        b_frag[10] = b2.z;
        b_frag[11] = b2.w;
        b_frag[12] = b3.x;
        b_frag[13] = b3.y;
        b_frag[14] = b3.z;
        b_frag[15] = b3.w;
        o_frag[l] = coopMatMulAdd(b_frag, p_frag[j], o_frag[l]);
      }
    }
    if (next) {
      barrier();
      k_idx += 196608u;
      v_idx += 196608u;
      const uint c = tid & 7u;
      [[unroll]] for (uint j = 0u; j < 4u; ++j) {
        const uint r = (tid >> 3u) + (j << 4u);
        const uint c_swz = (c ^ r & 7u) << 1u;
        k_lds[r][c_swz] = k_prefetch[j][0];
        k_lds[r][c_swz + 1u] = k_prefetch[j][1];
      }
      const uint d_base = lane_mod16 << 2u;
      [[unroll]] for (uint j = 0u; j < 2u; ++j) {
        const uint r_v4 = (j << 3u) + (tid >> 4u);
        const f16vec4 v0 = v_prefetch[j][0];
        const f16vec4 v1 = v_prefetch[j][1];
        const f16vec4 v2 = v_prefetch[j][2];
        const f16vec4 v3 = v_prefetch[j][3];
        const uint s_base = r_v4 ^ (d_base & 15u) ^ (d_base >> 4u);
        v_lds[d_base][s_base] = f16vec4(v0.x, v1.x, v2.x, v3.x);
        v_lds[d_base + 1u][s_base ^ 1u] = f16vec4(v0.y, v1.y, v2.y, v3.y);
        v_lds[d_base + 2u][s_base ^ 2u] = f16vec4(v0.z, v1.z, v2.z, v3.z);
        v_lds[d_base + 3u][s_base ^ 3u] = f16vec4(v0.w, v1.w, v2.w, v3.w);
      }
      barrier();
    }
  }
  const uint out_r = q_block_row + (wave_id << 4u) + lane_mod16;
  const float inv_sum = 1.0f / row_sum;
  const uint out_row_base = (out_r << 10u) + head_v4_off + (lane_half << 1u);
  [[unroll]] for (uint l = 0u; l < 4u; ++l) {
    const uint col_vec4_idx = out_row_base + (l << 2u);
    const MatAcc acc = o_frag[l];
    const vec4 d0 = vec4(acc[0], acc[1], acc[2], acc[3]) * inv_sum;
    const vec4 d1 = vec4(acc[4], acc[5], acc[6], acc[7]) * inv_sum;
    buffer_out[col_vec4_idx] = f16vec4(d0);
    buffer_out[col_vec4_idx + 1u] = f16vec4(d1);
  }
}