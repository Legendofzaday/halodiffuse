#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) writeonly buffer OutLatents {
  uint out_pairs[];
};
layout(push_constant) uniform PushConstants {
  uint64_t seed;
  uint num_pairs;
  uint _pad;
}
pc;
uint64_t splitmix64(uint64_t z) {
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9UL;
  z = (z ^ (z >> 27)) * 0x94D049BB133111EBUL;
  return z ^ (z >> 31);
}
void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= pc.num_pairs) {
    return;
  }
  const uint64_t GAMMA = 0x9E3779B97F4A7C15UL;
  uint64_t idx = uint64_t(gid);
  uint64_t s0 = pc.seed + (2UL * idx + 1UL) * GAMMA;
  uint64_t s1 = pc.seed + (2UL * idx + 2UL) * GAMMA;
  uint64_t r0 = splitmix64(s0);
  uint64_t r1 = splitmix64(s1);
  const float INV_2P23 = 1.0 / 8388608.0;
  float u1 = (float(uint(r0 >> 41)) + 0.5) * INV_2P23;
  float u2 = float(uint(r1 >> 41)) * INV_2P23;
  float radius = sqrt(-2.0 * log(u1));
  float theta = 6.28318530717958647692 * u2;
  float z0 = radius * cos(theta);
  float z1 = radius * sin(theta);
  out_pairs[gid] = packHalf2x16(vec2(z0, z1));
}
