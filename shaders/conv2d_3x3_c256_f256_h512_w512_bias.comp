#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

const uint TILE_M = 16;
const uint TILE_N = 16;
const uint TILE_K = 16;

#define MatA coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseB>
#define MatB coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseA>
#define MatAcc                                                                 \
  coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>
#define MatOut                                                                 \
  coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer A {
  f16vec4 buffer_a[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer bias {
  f16vec4 buffer_bias[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

shared f16vec4 a_lds[128][8];
shared f16vec4 b_lds[32][32];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint block_m = gl_WorkGroupID.y;
  const uint block_n = gl_WorkGroupID.x;
  const uint block_row = block_m << 7u;
  const uint block_col = block_n << 7u;
  f16vec4 a_prefetch[4];
  f16vec4 b_prefetch[4];
  uint kh = 0u;
  uint kw = 0u;
  uint c_k = 0u;
  const uint c_a = tid & 7u;
  [[unroll]] for (uint i = 0u; i < 4u; ++i) {
    const uint r = (tid >> 3u) + (i << 5u);
    const uint global_m = block_row + r;
    const int out_y = int(global_m >> 9u);
    const int out_x = int(global_m & 511u);
    const int in_y = out_y + int(kh) - 1;
    const int in_x = out_x + int(kw) - 1;
    const bool valid = (in_y >= 0 && in_y < 512 && in_x >= 0 && in_x < 512);
    if (valid) {
      const uint a_off =
          (uint(in_y) << 15u) + (uint(in_x) << 6u) + (c_k >> 2u) + c_a;
      a_prefetch[i] = buffer_a[a_off];
    } else {
      a_prefetch[i] = f16vec4(0.0hf);
    }
  }
  const uint c_b = tid & 31u;
  [[unroll]] for (uint i = 0u; i < 4u; ++i) {
    const uint r = (tid >> 5u) + (i << 3u);
    const uint b_off =
        kh * 49152u + (kw << 14u) + (c_k + r << 6u) + (block_col >> 2u) + c_b;
    b_prefetch[i] = buffer_b[b_off];
  }
  [[unroll]] for (uint i = 0u; i < 4u; ++i) {
    const uint r = (tid >> 3u) + (i << 5u);
    const uint c_swz = c_a ^ r & 7u;
    a_lds[r][c_swz] = a_prefetch[i];
  }
  [[unroll]] for (uint i = 0u; i < 4u; ++i) {
    const uint r = (tid >> 5u) + (i << 3u);
    const uint c_swz = c_b ^ r & 31u;
    b_lds[r][c_swz] = b_prefetch[i];
  }
  barrier();
  MatA a_frag[2];
  MatB b_frag;
  MatAcc c_frag[2][4];
  [[unroll]] for (uint e = 0u; e < 2u; ++e) [[unroll]]
    for (uint l = 0u; l < 4u; ++l)
      c_frag[e][l] = MatAcc(0.0);
  for (uint i_step = 0u; i_step < 72u; ++i_step) {
    const bool next = i_step + 1u < 72u;
    if (next) {
      kh = (i_step + 1u) / 24u;
      kw = ((i_step + 1u) >> 3u) % 3u;
      c_k = ((i_step + 1u) & 7u) << 5u;
      [[unroll]] for (uint i = 0u; i < 4u; ++i) {
        const uint r = (tid >> 3u) + (i << 5u);
        const uint global_m = block_row + r;
        const int out_y = int(global_m >> 9u);
        const int out_x = int(global_m & 511u);
        const int in_y = out_y + int(kh) - 1;
        const int in_x = out_x + int(kw) - 1;
        const bool valid = (in_y >= 0 && in_y < 512 && in_x >= 0 && in_x < 512);
        if (valid) {
          const uint a_off =
              (uint(in_y) << 15u) + (uint(in_x) << 6u) + (c_k >> 2u) + c_a;
          a_prefetch[i] = buffer_a[a_off];
        } else {
          a_prefetch[i] = f16vec4(0.0hf);
        }
      }
      [[unroll]] for (uint i = 0u; i < 4u; ++i) {
        const uint r = (tid >> 5u) + (i << 3u);
        const uint b_off = kh * 49152u + (kw << 14u) + (c_k + r << 6u) +
                           (block_col >> 2u) + c_b;
        b_prefetch[i] = buffer_b[b_off];
      }
    }
    const uint wave_m = (tid >> 5u) & 3u;
    const uint wave_n = tid >> 7u;
    [[unroll]] for (uint j = 0u; j < 2u; ++j) {
      const uint k_offset = j << 4u;
      const uint c_base_a = j << 2u;
      [[unroll]] for (uint e = 0u; e < 2u; ++e) {
        const uint r_a = (wave_m << 5u) + (e << 4u) + (tid & 15u);
        const uint c0_a = c_base_a ^ r_a & 7u;
        const uint c1_a = c_base_a + 1u ^ r_a & 7u;
        const uint c2_a = c_base_a + 2u ^ r_a & 7u;
        const uint c3_a = c_base_a + 3u ^ r_a & 7u;
        const f16vec4 a0 = a_lds[r_a][c0_a];
        const f16vec4 a1 = a_lds[r_a][c1_a];
        const f16vec4 a2 = a_lds[r_a][c2_a];
        const f16vec4 a3 = a_lds[r_a][c3_a];
        a_frag[e][0] = a0.x;
        a_frag[e][1] = a0.y;
        a_frag[e][2] = a0.z;
        a_frag[e][3] = a0.w;
        a_frag[e][4] = a1.x;
        a_frag[e][5] = a1.y;
        a_frag[e][6] = a1.z;
        a_frag[e][7] = a1.w;
        a_frag[e][8] = a2.x;
        a_frag[e][9] = a2.y;
        a_frag[e][10] = a2.z;
        a_frag[e][11] = a2.w;
        a_frag[e][12] = a3.x;
        a_frag[e][13] = a3.y;
        a_frag[e][14] = a3.z;
        a_frag[e][15] = a3.w;
      }
      [[unroll]] for (uint l = 0u; l < 4u; ++l) {
        const uint r_b = k_offset + (tid & 15u);
        const uint c_base_b = (wave_n << 4u) + (l << 2u);
        const uint c0_b = c_base_b ^ r_b & 31u;
        const uint c1_b = c_base_b + 1u ^ r_b & 31u;
        const uint c2_b = c_base_b + 2u ^ r_b & 31u;
        const uint c3_b = c_base_b + 3u ^ r_b & 31u;
        const f16vec4 b0 = b_lds[r_b][c0_b];
        const f16vec4 b1 = b_lds[r_b][c1_b];
        const f16vec4 b2 = b_lds[r_b][c2_b];
        const f16vec4 b3 = b_lds[r_b][c3_b];
        b_frag[0] = b0.x;
        b_frag[1] = b0.y;
        b_frag[2] = b0.z;
        b_frag[3] = b0.w;
        b_frag[4] = b1.x;
        b_frag[5] = b1.y;
        b_frag[6] = b1.z;
        b_frag[7] = b1.w;
        b_frag[8] = b2.x;
        b_frag[9] = b2.y;
        b_frag[10] = b2.z;
        b_frag[11] = b2.w;
        b_frag[12] = b3.x;
        b_frag[13] = b3.y;
        b_frag[14] = b3.z;
        b_frag[15] = b3.w;
        [[unroll]] for (uint e = 0u; e < 2u; ++e)
          c_frag[e][l] = coopMatMulAdd(b_frag, a_frag[e], c_frag[e][l]);
      }
    }
    if (next) {
      barrier();
      [[unroll]] for (uint i = 0u; i < 4u; ++i) {
        const uint r = (tid >> 3u) + (i << 5u);
        const uint c_swz = c_a ^ r & 7u;
        a_lds[r][c_swz] = a_prefetch[i];
      }
      [[unroll]] for (uint i = 0u; i < 4u; ++i) {
        const uint r = (tid >> 5u) + (i << 3u);
        const uint c_swz = c_b ^ r & 31u;
        b_lds[r][c_swz] = b_prefetch[i];
      }
      barrier();
    }
  }
  const uint wave_m = (tid >> 5u) & 3u;
  const uint wave_n = tid >> 7u;
  const uint c_r_base = block_row + (wave_m << 5u) + (tid & 15u);
  const uint c_c_base = block_col + (wave_n << 6u) + ((tid >> 1u) & 8u);
  [[unroll]] for (uint l = 0u; l < 4u; ++l) {
    const uint col_vec4_idx = (c_c_base + (l << 4u)) >> 2u;
    const f16vec4 bias0 = buffer_bias[col_vec4_idx];
    const f16vec4 bias1 = buffer_bias[col_vec4_idx + 1u];
    [[unroll]] for (uint e = 0u; e < 2u; ++e) {
      const uint row_idx = c_r_base + (e << 4u);
      if (row_idx < 262144u) {
        const uint c_idx = (row_idx << 6u) + col_vec4_idx;
        const MatOut d = MatOut(c_frag[e][l]);
        buffer_c[c_idx] = f16vec4(d[0], d[1], d[2], d[3]) + bias0;
        buffer_c[c_idx + 1u] = f16vec4(d[4], d[5], d[6], d[7]) + bias1;
      }
    }
  }
}
