#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) restrict buffer QKV {
  f16vec4 buffer_qkv[];
};
layout(std430, set = 0, binding = 1) readonly restrict buffer GammaQ {
  f16vec4 gamma_q[];
};
layout(std430, set = 0, binding = 2) readonly restrict buffer GammaK {
  f16vec4 gamma_k[];
};
void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint head_idx = (gl_WorkGroupID.x << 3u) + (tid >> 4u);
  const uint pos = gl_WorkGroupID.y;
  const uint lane_pair = tid & 15u;
  const uint head_base = pos * 1536u + (head_idx << 5u);
  const vec4 v_lo = vec4(buffer_qkv[head_base + lane_pair]);
  const vec4 v_hi = vec4(buffer_qkv[head_base + 16u + lane_pair]);
  float sum_sq = v_lo.x * v_lo.x;
  sum_sq = fma(v_lo.y, v_lo.y, sum_sq);
  sum_sq = fma(v_lo.z, v_lo.z, sum_sq);
  sum_sq = fma(v_lo.w, v_lo.w, sum_sq);
  sum_sq = fma(v_hi.x, v_hi.x, sum_sq);
  sum_sq = fma(v_hi.y, v_hi.y, sum_sq);
  sum_sq = fma(v_hi.z, v_hi.z, sum_sq);
  sum_sq = fma(v_hi.w, v_hi.w, sum_sq);
  sum_sq += subgroupShuffleXor(sum_sq, 8u);
  sum_sq += subgroupShuffleXor(sum_sq, 4u);
  sum_sq += subgroupShuffleXor(sum_sq, 2u);
  sum_sq += subgroupShuffleXor(sum_sq, 1u);
  const float rstd = inversesqrt(fma(sum_sq, 0.0078125f, 1e-6f));
  const bool is_k = head_idx >= 32u;
  const vec4 g_lo = vec4(is_k ? gamma_k[lane_pair] : gamma_q[lane_pair]);
  const vec4 g_hi =
      vec4(is_k ? gamma_k[16u + lane_pair] : gamma_q[16u + lane_pair]);
  const vec4 q_lo = v_lo * rstd * g_lo;
  const vec4 q_hi = v_hi * rstd * g_hi;
  const vec4 j = vec4(lane_pair << 2u) + vec4(0.0f, 1.0f, 2.0f, 3.0f);
  const vec4 theta = float(pos) * exp2(j * (-19.9315685693f / 64.0f));
  const vec4 c = cos(theta);
  const vec4 s = sin(theta);
  buffer_qkv[head_base + lane_pair] = f16vec4(fma(q_lo, c, -q_hi * s));
  buffer_qkv[head_base + 16u + lane_pair] = f16vec4(fma(q_hi, c, q_lo * s));
}
