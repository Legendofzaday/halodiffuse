#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants { float dt; }
pc;

layout(std430, set = 0, binding = 0) readonly restrict buffer V {
  f16vec4 buffer_v[];
};

layout(std430, set = 0, binding = 1) restrict buffer X { f16vec4 buffer_x[]; };

void main() {
  const uint idx = (gl_WorkGroupID.x << 8u) + gl_LocalInvocationID.x;
  const vec4 v = vec4(buffer_v[idx]);
  const vec4 x = vec4(buffer_x[idx]);
  buffer_x[idx] = f16vec4(fma(v, vec4(pc.dt), x));
}