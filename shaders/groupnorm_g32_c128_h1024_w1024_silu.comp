#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer In {
  f16vec4 buffer_in[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer Gamma {
  f16vec4 buffer_gamma[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer Beta {
  f16vec4 buffer_beta[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer Out {
  f16vec4 buffer_out[];
};

shared vec2 wave_stats[8];

const float INV_D = 1.0f / 4194304.0f;
const float EPS = 1e-6f;

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint g = gl_WorkGroupID.x;
  float thread_sum = 0.0f;
  float thread_sum_sq = 0.0f;
  for (uint i = 0u; i < 4096u; ++i) {
    const uint pixel = (i << 8u) + tid;
    const uint idx = (pixel << 5u) + g;
    const vec4 d = vec4(buffer_in[idx]);
    thread_sum += (d.x + d.y) + (d.z + d.w);
    thread_sum_sq = fma(d.x, d.x, thread_sum_sq);
    thread_sum_sq = fma(d.y, d.y, thread_sum_sq);
    thread_sum_sq = fma(d.z, d.z, thread_sum_sq);
    thread_sum_sq = fma(d.w, d.w, thread_sum_sq);
  }

  const vec2 wave_total = subgroupAdd(vec2(thread_sum, thread_sum_sq));
  if (subgroupElect()) {
    wave_stats[gl_SubgroupID] = wave_total;
  }
  barrier();
  if (tid == 0u) {
    vec2 block_total = vec2(0.0f);
    [[unroll]] for (uint i = 0u; i < 8u; ++i)
      block_total += wave_stats[i];
    const float mean = block_total.x * INV_D;
    const float var = max(0.0f, fma(-mean, mean, block_total.y * INV_D));
    const float rstd = inversesqrt(var + EPS);
    wave_stats[0] = vec2(mean, rstd);
  }
  barrier();
  const float mean = wave_stats[0].x;
  const float rstd = wave_stats[0].y;
  const float neg_mean_rstd = -mean * rstd;
  const vec4 g_v = vec4(buffer_gamma[g]);
  const vec4 b_v = vec4(buffer_beta[g]);
  const vec4 log2e = vec4(-1.44269504f);
  const vec4 one = vec4(1.0f);
  for (uint i = 0u; i < 4096u; ++i) {
    const uint pixel = (i << 8u) + tid;
    const uint idx = (pixel << 5u) + g;
    const vec4 d = vec4(buffer_in[idx]);
    const vec4 x_n = fma(d, vec4(rstd), vec4(neg_mean_rstd));
    const vec4 y = fma(x_n, g_v, b_v);
    const vec4 sig = one / (exp2(y * log2e) + one);
    buffer_out[idx] = f16vec4(y * sig);
  }
}
