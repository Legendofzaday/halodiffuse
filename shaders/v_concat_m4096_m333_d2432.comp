#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer A {
  f16vec4 buffer_a[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint wgid = gl_WorkGroupID.x;
  const uint batch_idx = wgid / 4429u;
  const uint row = wgid % 4429u;
  const uint out_row_base = wgid * 608u;
  if (row < 4096u) {
    const uint in_row_base = (batch_idx * 4096u + row) * 608u;
    [[unroll]] for (uint i = 0u; i < 2u; ++i) {
      const uint col = (i << 8u) + tid;
      buffer_c[out_row_base + col] = buffer_a[in_row_base + col];
    }
    if (tid < 96u) {
      const uint col = 512u + tid;
      buffer_c[out_row_base + col] = buffer_a[in_row_base + col];
    }
  } else {
    const uint in_row_base = (batch_idx * 333u + (row - 4096u)) * 608u;
    [[unroll]] for (uint i = 0u; i < 2u; ++i) {
      const uint col = (i << 8u) + tid;
      buffer_c[out_row_base + col] = buffer_b[in_row_base + col];
    }
    if (tid < 96u) {
      const uint col = 512u + tid;
      buffer_c[out_row_base + col] = buffer_b[in_row_base + col];
    }
  }
}