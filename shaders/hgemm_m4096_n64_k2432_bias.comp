#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

const uint TILE_M = 16;
const uint TILE_N = 16;
const uint TILE_K = 16;

#define MatA coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseB>
#define MatB coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseA>
#define MatAcc                                                                 \
  coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>
#define MatOut                                                                 \
  coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer A {
  f16vec4 buffer_a[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer bias {
  f16vec4 buffer_bias[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

shared f16vec4 a_lds[128][32];
shared f16vec4 b_lds[128][16];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint block_m = gl_WorkGroupID.x + gl_WorkGroupID.y;
  const uint block_row = block_m << 7u;
  uint a_idx = 608u * (block_row + (tid >> 4u)) + ((tid & 15u) << 1u);
  uint b_idx = ((tid >> 3u) << 4u) + ((tid & 7u) << 1u);
  {
    const uint c_a = tid & 15u;
    [[unroll]] for (uint i = 0u; i < 8u; ++i) {
      const uint r = (tid >> 4u) + (i << 4u);
      const uint c_swz = (c_a ^ r & 15u) << 1u;
      const uint a_off = a_idx + 9728u * i;
      a_lds[r][c_swz] = buffer_a[a_off];
      a_lds[r][c_swz + 1u] = buffer_a[a_off + 1u];
    }
    const uint c_b = tid & 7u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
      const uint r = (tid >> 3u) + (i << 5u);
      const uint c_swz = (c_b ^ r & 7u) << 1u;
      const uint b_off = b_idx + (i << 9u);
      b_lds[r][c_swz] = buffer_b[b_off];
      b_lds[r][c_swz + 1u] = buffer_b[b_off + 1u];
    }
  }
  barrier();
  f16vec4 a_prefetch[8][2];
  f16vec4 b_prefetch[4][2];
  MatA a_frag;
  MatB b_frag;
  MatAcc c_frag[4];
  [[unroll]] for (uint l = 0u; l < 4u; ++l)
    c_frag[l] = MatAcc(0.0);
  for (uint i = 0u; i < 2432u; i += 128u) {
    const bool next = i + 128u < 2432u;
    if (next) {
      [[unroll]] for (uint j = 0u; j < 8u; ++j) {
        const uint a_off = a_idx + 9728u * j + 32u;
        a_prefetch[j][0] = buffer_a[a_off];
        a_prefetch[j][1] = buffer_a[a_off + 1u];
      }
      [[unroll]] for (uint j = 0u; j < 4u; ++j) {
        const uint b_off = b_idx + (j << 9u) + 2048u;
        b_prefetch[j][0] = buffer_b[b_off];
        b_prefetch[j][1] = buffer_b[b_off + 1u];
      }
    }
    [[unroll]] for (uint j = 0u; j < 8u; ++j) {
      const uint k_offset = j << 4u;
      const uint c_base_a = j << 1u;
      const uint r_a = ((tid >> 1u) & ~15u) + (tid & 15u);
      const uint c0_a = (c_base_a ^ r_a & 15u) << 1u;
      const uint c1_a = (c_base_a + 1u ^ r_a & 15u) << 1u;
      const f16vec4 a0 = a_lds[r_a][c0_a];
      const f16vec4 a1 = a_lds[r_a][c0_a + 1u];
      const f16vec4 a2 = a_lds[r_a][c1_a];
      const f16vec4 a3 = a_lds[r_a][c1_a + 1u];
      a_frag[0] = a0.x;
      a_frag[1] = a0.y;
      a_frag[2] = a0.z;
      a_frag[3] = a0.w;
      a_frag[4] = a1.x;
      a_frag[5] = a1.y;
      a_frag[6] = a1.z;
      a_frag[7] = a1.w;
      a_frag[8] = a2.x;
      a_frag[9] = a2.y;
      a_frag[10] = a2.z;
      a_frag[11] = a2.w;
      a_frag[12] = a3.x;
      a_frag[13] = a3.y;
      a_frag[14] = a3.z;
      a_frag[15] = a3.w;
      [[unroll]] for (uint l = 0u; l < 4u; ++l) {
        const uint r_b = k_offset + (tid & 15u);
        const uint c_base_b = l << 1u;
        const uint c0_b = (c_base_b ^ r_b & 7u) << 1u;
        const uint c1_b = (c_base_b + 1u ^ r_b & 7u) << 1u;
        const f16vec4 b0 = b_lds[r_b][c0_b];
        const f16vec4 b1 = b_lds[r_b][c0_b + 1u];
        const f16vec4 b2 = b_lds[r_b][c1_b];
        const f16vec4 b3 = b_lds[r_b][c1_b + 1u];
        b_frag[0] = b0.x;
        b_frag[1] = b0.y;
        b_frag[2] = b0.z;
        b_frag[3] = b0.w;
        b_frag[4] = b1.x;
        b_frag[5] = b1.y;
        b_frag[6] = b1.z;
        b_frag[7] = b1.w;
        b_frag[8] = b2.x;
        b_frag[9] = b2.y;
        b_frag[10] = b2.z;
        b_frag[11] = b2.w;
        b_frag[12] = b3.x;
        b_frag[13] = b3.y;
        b_frag[14] = b3.z;
        b_frag[15] = b3.w;
        c_frag[l] = coopMatMulAdd(b_frag, a_frag, c_frag[l]);
      }
    }
    if (next) {
      barrier();
      a_idx += 32u;
      b_idx += 2048u;
      const uint c_a = tid & 15u;
      [[unroll]] for (uint j = 0u; j < 8u; ++j) {
        const uint r = (tid >> 4u) + (j << 4u);
        const uint c_swz = (c_a ^ r & 15u) << 1u;
        a_lds[r][c_swz] = a_prefetch[j][0];
        a_lds[r][c_swz + 1u] = a_prefetch[j][1];
      }
      const uint c_b = tid & 7u;
      [[unroll]] for (uint j = 0u; j < 4u; ++j) {
        const uint r = (tid >> 3u) + (j << 5u);
        const uint c_swz = (c_b ^ r & 7u) << 1u;
        b_lds[r][c_swz] = b_prefetch[j][0];
        b_lds[r][c_swz + 1u] = b_prefetch[j][1];
      }
      barrier();
    }
  }
  const uint c_r_base = block_row + ((tid >> 1u) & ~15u) + (tid & 15u);
  const uint c_c_base = (tid >> 1u) & 8u;
  [[unroll]] for (uint l = 0u; l < 4u; ++l) {
    const uint col_vec4_idx = (c_c_base + (l << 4u)) >> 2u;
    const f16vec4 bias0 = buffer_bias[col_vec4_idx];
    const f16vec4 bias1 = buffer_bias[col_vec4_idx + 1u];
    if (c_r_base < 4096u) {
      const uint c_row_offset = c_r_base << 4u;
      const MatOut d = MatOut(c_frag[l]);
      buffer_c[c_row_offset + col_vec4_idx] =
          f16vec4(d[0], d[1], d[2], d[3]) + bias0;
      buffer_c[c_row_offset + col_vec4_idx + 1u] =
          f16vec4(d[4], d[5], d[6], d[7]) + bias1;
    }
  }
}