#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer data {
  f16vec4 buffer_data[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer gamma {
  f16vec4 buffer_gamma[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer beta {
  f16vec4 buffer_beta[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer normalized {
  f16vec4 buffer_normalized[];
};

shared float wave_sums[4];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint row_offset = gl_WorkGroupID.x * 608u;
  const uint idx0 = tid << 1u;
  const uint idx1 = idx0 + 256u;
  const uint idx2 = tid + 512u;
  const f16vec4 a0 = buffer_data[row_offset + idx0];
  const f16vec4 a1 = buffer_data[row_offset + idx0 + 1u];
  const f16vec4 a2 = buffer_data[row_offset + idx1];
  const f16vec4 a3 = buffer_data[row_offset + idx1 + 1u];
  f16vec4 a4 = f16vec4(0.0hf);
  if (tid < 96u) {
    a4 = buffer_data[row_offset + idx2];
  }
  const vec4 v0 = vec4(a0);
  const vec4 v1 = vec4(a1);
  const vec4 v2 = vec4(a2);
  const vec4 v3 = vec4(a3);
  const vec4 v4 = vec4(a4);
  vec4 sum_vec = fma(v0, v0, v1 * v1);
  sum_vec = fma(v2, v2, sum_vec);
  sum_vec = fma(v3, v3, sum_vec);
  sum_vec = fma(v4, v4, sum_vec);
  float thread_sum = (sum_vec.x + sum_vec.y) + (sum_vec.z + sum_vec.w);
  thread_sum = subgroupAdd(thread_sum);
  const uint wave = tid >> 5u;
  const uint lane = tid & 31u;
  if (lane == 0u) {
    wave_sums[wave] = thread_sum;
  }
  barrier();
  const float block_sum =
      (wave_sums[0] + wave_sums[1]) + (wave_sums[2] + wave_sums[3]);
  const vec4 rrms = vec4(inversesqrt(block_sum * (1.0 / 2432.0) + 1e-6));
  const vec4 g0 = vec4(buffer_gamma[idx0]);
  const vec4 g1 = vec4(buffer_gamma[idx0 + 1u]);
  const vec4 g2 = vec4(buffer_gamma[idx1]);
  const vec4 g3 = vec4(buffer_gamma[idx1 + 1u]);
  const vec4 b0 = vec4(buffer_beta[idx0]);
  const vec4 b1 = vec4(buffer_beta[idx0 + 1u]);
  const vec4 b2 = vec4(buffer_beta[idx1]);
  const vec4 b3 = vec4(buffer_beta[idx1 + 1u]);
  buffer_normalized[row_offset + idx0] = f16vec4(fma(v0 * rrms, g0, b0));
  buffer_normalized[row_offset + idx0 + 1u] = f16vec4(fma(v1 * rrms, g1, b1));
  buffer_normalized[row_offset + idx1] = f16vec4(fma(v2 * rrms, g2, b2));
  buffer_normalized[row_offset + idx1 + 1u] = f16vec4(fma(v3 * rrms, g3, b3));
  if (tid < 96u) {
    const vec4 g4 = vec4(buffer_gamma[idx2]);
    const vec4 b4 = vec4(buffer_beta[idx2]);
    buffer_normalized[row_offset + idx2] = f16vec4(fma(v4 * rrms, g4, b4));
  }
}