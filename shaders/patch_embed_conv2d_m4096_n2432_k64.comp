#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

const uint TILE_M = 16;
const uint TILE_N = 16;
const uint TILE_K = 16;

#define MatA coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseA>
#define MatB coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseB>
#define MatAcc                                                                 \
  coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>
#define MatOut                                                                 \
  coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer A {
  f16vec4 buffer_a[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer bias {
  f16vec4 buffer_bias[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

shared f16vec4 a_lds[128][16];
shared f16vec4 b_lds[64][32];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint block_id = gl_WorkGroupID.y * 19u + gl_WorkGroupID.x;
  uint block_m = block_id - 576u;
  uint block_n = 18u;
  if (block_id < 576u) {
    const uint s_outer = block_id >> 2u;
    const uint s_inner = block_id & 3u;
    const uint s_m = s_outer / 9u;
    uint s_n = s_outer % 9u;
    if ((s_m & 1u) != 0u) {
      s_n = 8u - s_n;
    }
    const uint local_m = s_inner >> 1u;
    const uint local_n = local_m ^ s_inner & 1u;
    block_m = (s_m << 1u) + local_m;
    block_n = (s_n << 1u) + local_n;
  }
  const uint block_row = block_m << 7u;
  const uint block_col = block_n << 7u;
  uint a_idx = 16u * (block_row + (tid >> 3u)) + ((tid & 7u) << 1u);
  uint b_idx = 608u * (tid >> 4u) + (block_col >> 2u) + ((tid & 15u) << 1u);
  {
    const uint c_a = tid & 7u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
      const uint r = (tid >> 3u) + (i << 5u);
      const uint c_swz = (c_a ^ r & 7u) << 1u;
      const uint a_off = a_idx + 512u * i;
      a_lds[r][c_swz] = buffer_a[a_off];
      a_lds[r][c_swz + 1u] = buffer_a[a_off + 1u];
    }
    const uint c_b = tid & 15u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
      const uint r = (tid >> 4u) + (i << 4u);
      const uint c_swz = (c_b ^ r & 15u) << 1u;
      const uint b_off = b_idx + 9728u * i;
      b_lds[r][c_swz] = buffer_b[b_off];
      b_lds[r][c_swz + 1u] = buffer_b[b_off + 1u];
    }
  }
  barrier();
  MatA a_frag[2];
  MatB b_frag;
  MatAcc c_frag[2][4];
  [[unroll]] for (uint e = 0u; e < 2u; ++e) {
    [[unroll]] for (uint l = 0u; l < 4u; ++l) { c_frag[e][l] = MatAcc(0.0); }
  }
  [[unroll]] for (uint j = 0u; j < 4u; ++j) {
    const uint k_offset = j << 4u;
    const uint c_base_a = j << 1u;
    [[unroll]] for (uint e = 0u; e < 2u; ++e) {
      const uint r = (tid >> 6u << 5u) + (e << 4u) + (tid & 15u);
      const uint c0 = (c_base_a ^ r & 7u) << 1u;
      const uint c1 = (c_base_a + 1u ^ r & 7u) << 1u;
      const f16vec4 a0 = a_lds[r][c0];
      const f16vec4 a1 = a_lds[r][c0 + 1u];
      const f16vec4 a2 = a_lds[r][c1];
      const f16vec4 a3 = a_lds[r][c1 + 1u];
      a_frag[e][0] = a0.x;
      a_frag[e][1] = a0.y;
      a_frag[e][2] = a0.z;
      a_frag[e][3] = a0.w;
      a_frag[e][4] = a1.x;
      a_frag[e][5] = a1.y;
      a_frag[e][6] = a1.z;
      a_frag[e][7] = a1.w;
      a_frag[e][8] = a2.x;
      a_frag[e][9] = a2.y;
      a_frag[e][10] = a2.z;
      a_frag[e][11] = a2.w;
      a_frag[e][12] = a3.x;
      a_frag[e][13] = a3.y;
      a_frag[e][14] = a3.z;
      a_frag[e][15] = a3.w;
    }
    [[unroll]] for (uint l = 0u; l < 4u; ++l) {
      const uint r = k_offset + (tid & 15u);
      const uint c = (((tid >> 5u) & 1u) << 3u) + (l << 1u);
      const uint c0 = (c ^ r & 15u) << 1u;
      const uint c1 = (c + 1u ^ r & 15u) << 1u;
      const f16vec4 b0 = b_lds[r][c0];
      const f16vec4 b1 = b_lds[r][c0 + 1u];
      const f16vec4 b2 = b_lds[r][c1];
      const f16vec4 b3 = b_lds[r][c1 + 1u];
      b_frag[0] = b0.x;
      b_frag[1] = b0.y;
      b_frag[2] = b0.z;
      b_frag[3] = b0.w;
      b_frag[4] = b1.x;
      b_frag[5] = b1.y;
      b_frag[6] = b1.z;
      b_frag[7] = b1.w;
      b_frag[8] = b2.x;
      b_frag[9] = b2.y;
      b_frag[10] = b2.z;
      b_frag[11] = b2.w;
      b_frag[12] = b3.x;
      b_frag[13] = b3.y;
      b_frag[14] = b3.z;
      b_frag[15] = b3.w;
      [[unroll]] for (uint e = 0u; e < 2u; ++e) {
        c_frag[e][l] = coopMatMulAdd(a_frag[e], b_frag, c_frag[e][l]);
      }
    }
  }
  const uint c_r_base = block_row + (tid >> 6u << 5u) + (tid & 15u);
  const uint c_c_base =
      block_col + (((tid >> 5u) & 1u) << 6u) + (((tid & 31u) >> 4u) << 3u);
  [[unroll]] for (uint l = 0u; l < 4u; ++l) {
    const uint col_vec4_idx = (c_c_base + (l << 4u)) >> 2u;
    [[unroll]] for (uint e = 0u; e < 2u; ++e) {
      const uint row_idx = c_r_base + (e << 4u);
      const uint c_row_offset = row_idx * 608u;
      const uint idx = c_row_offset + col_vec4_idx;
      const f16vec4 bias0 = buffer_bias[idx];
      const f16vec4 bias1 = buffer_bias[idx + 1u];
      const MatOut d = MatOut(c_frag[e][l]);
      buffer_c[idx] = f16vec4(d[0], d[1], d[2], d[3]) + bias0;
      buffer_c[idx + 1u] = f16vec4(d[4], d[5], d[6], d[7]) + bias1;
    }
  }
}