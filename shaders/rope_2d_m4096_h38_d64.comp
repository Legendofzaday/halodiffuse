#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer QKIn {
  f16vec4 buffer_qk_in[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer Cos {
  f16vec4 buffer_cos[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer Sin {
  f16vec4 buffer_sin[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer QKOut {
  f16vec4 buffer_qk_out[];
};

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint seq_idx = gl_WorkGroupID.x;
  const uint base_idx = seq_idx * 1216u;
  const uint cos_sin_base = seq_idx << 4u;
  [[unroll]] for (uint i = 0u; i < 5u; ++i) {
    const uint offset = i * 256u + tid;
    if (offset < 1216u) {
      const uint dim_v4 = offset & 15u;
      const f16vec4 qk_val = buffer_qk_in[base_idx + offset];
      const f16vec4 cos_val = buffer_cos[cos_sin_base + dim_v4];
      const f16vec4 sin_val = buffer_sin[cos_sin_base + dim_v4];
      const f16vec4 qk_rot = f16vec4(-qk_val.y, qk_val.x, -qk_val.w, qk_val.z);
      buffer_qk_out[base_idx + offset] = fma(qk_rot, sin_val, qk_val * cos_val);
    }
  }
}