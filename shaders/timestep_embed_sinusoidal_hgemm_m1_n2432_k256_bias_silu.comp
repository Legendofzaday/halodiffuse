#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer T {
  float buffer_t[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer bias {
  f16vec4 buffer_bias[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

shared f16vec4 c_lds[64];
shared vec4 wave_sums[8][33];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  if (tid < 32u) {
    const float t = buffer_t[0];
    const vec4 j = vec4(tid << 2u) + vec4(0.0f, 1.0f, 2.0f, 3.0f);
    const vec4 exponent = j * -0.10381025296f;
    const vec4 emb = exp2(exponent) * t;
    c_lds[tid] = f16vec4(cos(emb));
    c_lds[tid + 32u] = f16vec4(sin(emb));
  }
  const uint n_tid = tid & 31u;
  const uint k_tid = tid >> 5u;
  const uint wg_col_base = gl_WorkGroupID.x << 5u;
  const uint col_vec4_idx = wg_col_base + n_tid;
  vec4 acc = vec4(0.0f);
  uint b_idx = (k_tid << 2u) * 608u + col_vec4_idx;
  barrier();
  [[unroll]] for (uint i = 0u; i < 8u; ++i) {
    const uint k_vec4_idx = (i << 3u) + k_tid;
    const vec4 a_val = vec4(c_lds[k_vec4_idx]);
    const vec4 b0 = vec4(buffer_b[b_idx]);
    const vec4 b1 = vec4(buffer_b[b_idx + 608u]);
    const vec4 b2 = vec4(buffer_b[b_idx + 1216u]);
    const vec4 b3 = vec4(buffer_b[b_idx + 1824u]);
    acc = fma(vec4(a_val.x), b0, acc);
    acc = fma(vec4(a_val.y), b1, acc);
    acc = fma(vec4(a_val.z), b2, acc);
    acc = fma(vec4(a_val.w), b3, acc);
    b_idx += 19456u;
  }
  wave_sums[k_tid][n_tid] = acc;
  barrier();
  const uint wave_id = tid & 7u;
  const uint col_id = tid >> 3u;
  vec4 block_sum = wave_sums[wave_id][col_id];
  block_sum += subgroupShuffleDown(block_sum, 4u);
  block_sum += subgroupShuffleDown(block_sum, 2u);
  block_sum += subgroupShuffleDown(block_sum, 1u);
  if (wave_id == 0u) {
    const uint out_col_idx = wg_col_base + col_id;
    const vec4 b = vec4(buffer_bias[out_col_idx]);
    const f16vec4 h0 = f16vec4(block_sum + b);
    const f16vec4 log2e = f16vec4(-1.44269504hf);
    const f16vec4 one = f16vec4(1.0hf);
    const f16vec4 r0 = one / (exp2(h0 * log2e) + one);
    buffer_c[out_col_idx] = h0 * r0;
  }
}