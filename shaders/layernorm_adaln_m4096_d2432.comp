#version 460

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer dataV4 {
  f16vec4 data_v4[];
};

layout(set = 0, binding = 0, std430) readonly restrict buffer dataV2 {
  f16vec2 data_v2[];
};

layout(set = 0, binding = 0, std430) readonly restrict buffer data {
  float16_t data_f16[];
};

layout(set = 0, binding = 1, std430) readonly restrict buffer gammaV4 {
  f16vec4 gamma_v4[];
};

layout(set = 0, binding = 1, std430) readonly restrict buffer gammaV2 {
  f16vec2 gamma_v2[];
};

layout(set = 0, binding = 1, std430) readonly restrict buffer gamma {
  float16_t gamma_f16[];
};

layout(set = 0, binding = 2, std430) readonly restrict buffer betaV4 {
  f16vec4 beta_v4[];
};

layout(set = 0, binding = 2, std430) readonly restrict buffer betaV2 {
  f16vec2 beta_v2[];
};

layout(set = 0, binding = 2, std430) readonly restrict buffer beta {
  float16_t beta_f16[];
};

layout(set = 0, binding = 3, std430) writeonly restrict buffer normV4 {
  f16vec4 norm_v4[];
};

layout(set = 0, binding = 3, std430) writeonly restrict buffer normV2 {
  f16vec2 norm_v2[];
};

layout(set = 0, binding = 3, std430) writeonly restrict buffer norm {
  float16_t norm_f16[];
};

shared vec2 wave_stats[4];

const float INV_D = 1.0f / 2432.0f;
const float EPS = 1e-6f;

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint wgid = gl_WorkGroupID.x;
  const uint row_v4 = wgid * 608u;
  const uint row_v2 = wgid * 1216u;
  const uint row_f16 = wgid * 2432u;
  const uint batch_idx = wgid >> 12u;
  const uint batch_v4 = batch_idx * 608u;
  const uint batch_v2 = batch_idx * 1216u;
  const uint batch_f16 = batch_idx * 2432u;
  f16vec4 r_data_v4[4];
  [[unroll]]
  for (uint i = 0u; i < 4u; ++i) {
    r_data_v4[i] = data_v4[row_v4 + (i << 7u) + tid];
  }
  const f16vec2 r_data_v2 = data_v2[row_v2 + 1024u + tid];
  const float16_t r_data_f16 = data_f16[row_f16 + 2304u + tid];
  f16vec4 r_gamma_v4[4];
  f16vec4 r_beta_v4[4];
  [[unroll]]
  for (uint i = 0u; i < 4u; ++i) {
    r_gamma_v4[i] = gamma_v4[batch_v4 + (i << 7u) + tid];
    r_beta_v4[i] = beta_v4[batch_v4 + (i << 7u) + tid];
  }
  const f16vec2 r_gamma_v2 = gamma_v2[batch_v2 + 1024u + tid];
  const float16_t r_gamma_f16 = gamma_f16[batch_f16 + 2304u + tid];
  const f16vec2 r_beta_v2 = beta_v2[batch_v2 + 1024u + tid];
  const float16_t r_beta_f16 = beta_f16[batch_f16 + 2304u + tid];
  vec4 d_v4[4];
  float thread_sum = 0.0f;
  float thread_sum_sq = 0.0f;
  [[unroll]]
  for (uint i = 0u; i < 4u; ++i) {
    d_v4[i] = vec4(r_data_v4[i]);
    thread_sum += (d_v4[i].x + d_v4[i].y) + (d_v4[i].z + d_v4[i].w);
    thread_sum_sq = fma(d_v4[i].x, d_v4[i].x, thread_sum_sq);
    thread_sum_sq = fma(d_v4[i].y, d_v4[i].y, thread_sum_sq);
    thread_sum_sq = fma(d_v4[i].z, d_v4[i].z, thread_sum_sq);
    thread_sum_sq = fma(d_v4[i].w, d_v4[i].w, thread_sum_sq);
  }
  const vec2 d_v2 = vec2(r_data_v2);
  thread_sum += d_v2.x + d_v2.y;
  thread_sum_sq = fma(d_v2.x, d_v2.x, thread_sum_sq);
  thread_sum_sq = fma(d_v2.y, d_v2.y, thread_sum_sq);
  const float d_f16 = float(r_data_f16);
  thread_sum += d_f16;
  thread_sum_sq = fma(d_f16, d_f16, thread_sum_sq);
  const vec2 wave_total = subgroupAdd(vec2(thread_sum, thread_sum_sq));
  if (subgroupElect()) {
    wave_stats[gl_SubgroupID] = wave_total;
  }
  barrier();
  const vec2 block_total =
      (wave_stats[0] + wave_stats[1]) + (wave_stats[2] + wave_stats[3]);
  const float mean = block_total.x * INV_D;
  const float var = max(0.0f, fma(-mean, mean, block_total.y * INV_D));
  const float rstd = inversesqrt(var + EPS);
  const float neg_mean_rstd = -mean * rstd;
  [[unroll]]
  for (uint i = 0u; i < 4u; ++i) {
    const vec4 g = vec4(r_gamma_v4[i]);
    const vec4 b = vec4(r_beta_v4[i]);
    const vec4 x_n = fma(d_v4[i], vec4(rstd), vec4(neg_mean_rstd));
    norm_v4[row_v4 + (i << 7u) + tid] = f16vec4(fma(x_n, g, b));
  }
  const vec2 g_v2 = vec2(r_gamma_v2);
  const vec2 b_v2 = vec2(r_beta_v2);
  const vec2 x_n_v2 = fma(d_v2, vec2(rstd), vec2(neg_mean_rstd));
  norm_v2[row_v2 + 1024u + tid] = f16vec2(fma(x_n_v2, g_v2, b_v2));
  const float g_f16 = float(r_gamma_f16);
  const float b_f16 = float(r_beta_f16);
  const float x_n_f16 = fma(d_f16, rstd, neg_mean_rstd);
  norm_f16[row_f16 + 2304u + tid] = float16_t(fma(x_n_f16, g_f16, b_f16));
}