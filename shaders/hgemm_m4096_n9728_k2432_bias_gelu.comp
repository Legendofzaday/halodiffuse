#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

const uint TILE_M = 16;
const uint TILE_N = 16;
const uint TILE_K = 16;

#define MatA coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseA>
#define MatB coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_M, gl_MatrixUseB>
#define MatAcc                                                                 \
  coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>
#define MatOut                                                                 \
  coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>

layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer A {
  f16vec4 buffer_a[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer bias {
  f16vec4 buffer_bias[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

shared f16vec4 a_lds[256][16];
shared f16vec4 b_lds[64][64];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint block_id = gl_WorkGroupID.y * 38u + gl_WorkGroupID.x;
  const uint s_outer = block_id >> 2u;
  const uint s_inner = block_id & 3u;
  const uint s_m = s_outer / 19u;
  uint s_n = s_outer % 19u;
  if ((s_m & 1u) != 0u) {
    s_n = 18u - s_n;
  }
  const uint local_m = s_inner >> 1u;
  const uint local_n = local_m ^ s_inner & 1u;
  const uint block_m = (s_m << 1u) + local_m;
  const uint block_n = (s_n << 1u) + local_n;
  const uint block_row = block_m << 8u;
  const uint block_col = block_n << 8u;
  uint a_idx = 608u * (block_row + (tid >> 3u)) + ((tid & 7u) << 1u);
  uint b_idx = 2432u * (tid >> 5u) + (block_col >> 2u) + ((tid & 31u) << 1u);
  {
    const uint c = tid & 7u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
      const uint r = (tid >> 3u) + (i << 6u);
      const uint c_swz = (c ^ r & 7u) << 1u;
      const uint a_off = a_idx + 38912u * i;
      a_lds[r][c_swz] = buffer_a[a_off];
      a_lds[r][c_swz + 1u] = buffer_a[a_off + 1u];
    }
  }
  {
    const uint c = tid & 31u;
    [[unroll]] for (uint i = 0u; i < 4u; ++i) {
      const uint r = (tid >> 5u) + (i << 4u);
      const uint c_swz = (c ^ r & 31u) << 1u;
      const uint b_off = b_idx + 38912u * i;
      b_lds[r][c_swz] = buffer_b[b_off];
      b_lds[r][c_swz + 1u] = buffer_b[b_off + 1u];
    }
  }
  barrier();
  f16vec4 a_prefetch[4][2];
  f16vec4 b_prefetch[4][2];
  MatA a_frag[4];
  MatB b_frag;
  MatAcc c_frag[4][4];
  [[unroll]] for (uint e = 0u; e < 4u; ++e) [[unroll]]
    for (uint l = 0u; l < 4u; ++l)
      c_frag[e][l] = MatAcc(0.0);
  for (uint i = 0u; i < 2432u; i += 64u) {
    const bool next = i + 64u < 2432u;
    if (next) {
      [[unroll]] for (uint j = 0u; j < 4u; ++j) {
        const uint a_off = a_idx + 38912u * j + 16u;
        a_prefetch[j][0] = buffer_a[a_off];
        a_prefetch[j][1] = buffer_a[a_off + 1u];
      }
      [[unroll]] for (uint j = 0u; j < 4u; ++j) {
        const uint b_off = b_idx + 38912u * j + 155648u;
        b_prefetch[j][0] = buffer_b[b_off];
        b_prefetch[j][1] = buffer_b[b_off + 1u];
      }
    }
    [[unroll]] for (uint j = 0u; j < 4u; ++j) {
      const uint k_offset = j << 4u;
      const uint c_base = j << 1u;
      [[unroll]] for (uint e = 0u; e < 4u; ++e) {
        const uint r = (tid >> 7u << 6u) + (e << 4u) + (tid & 15u);
        const uint c0 = (c_base ^ r & 7u) << 1u;
        const uint c1 = (c_base + 1u ^ r & 7u) << 1u;
        const f16vec4 a0 = a_lds[r][c0];
        const f16vec4 a1 = a_lds[r][c0 + 1u];
        const f16vec4 a2 = a_lds[r][c1];
        const f16vec4 a3 = a_lds[r][c1 + 1u];
        a_frag[e][0] = a0.x;
        a_frag[e][1] = a0.y;
        a_frag[e][2] = a0.z;
        a_frag[e][3] = a0.w;
        a_frag[e][4] = a1.x;
        a_frag[e][5] = a1.y;
        a_frag[e][6] = a1.z;
        a_frag[e][7] = a1.w;
        a_frag[e][8] = a2.x;
        a_frag[e][9] = a2.y;
        a_frag[e][10] = a2.z;
        a_frag[e][11] = a2.w;
        a_frag[e][12] = a3.x;
        a_frag[e][13] = a3.y;
        a_frag[e][14] = a3.z;
        a_frag[e][15] = a3.w;
      }
      [[unroll]] for (uint l = 0u; l < 4u; ++l) {
        const uint r = k_offset + (tid & 15u);
        const uint c = (((tid >> 5u) & 3u) << 3u) + (l << 1u);
        const uint c0 = (c ^ r & 31u) << 1u;
        const uint c1 = (c + 1u ^ r & 31u) << 1u;
        const f16vec4 b0 = b_lds[r][c0];
        const f16vec4 b1 = b_lds[r][c0 + 1u];
        const f16vec4 b2 = b_lds[r][c1];
        const f16vec4 b3 = b_lds[r][c1 + 1u];
        b_frag[0] = b0.x;
        b_frag[1] = b0.y;
        b_frag[2] = b0.z;
        b_frag[3] = b0.w;
        b_frag[4] = b1.x;
        b_frag[5] = b1.y;
        b_frag[6] = b1.z;
        b_frag[7] = b1.w;
        b_frag[8] = b2.x;
        b_frag[9] = b2.y;
        b_frag[10] = b2.z;
        b_frag[11] = b2.w;
        b_frag[12] = b3.x;
        b_frag[13] = b3.y;
        b_frag[14] = b3.z;
        b_frag[15] = b3.w;
        [[unroll]] for (uint e = 0u; e < 4u; ++e)
          c_frag[e][l] = coopMatMulAdd(a_frag[e], b_frag, c_frag[e][l]);
      }
    }
    if (next) {
      barrier();
      a_idx += 16u;
      b_idx += 155648u;
      {
        const uint c = tid & 7u;
        [[unroll]] for (uint j = 0u; j < 4u; ++j) {
          const uint r = (tid >> 3u) + (j << 6u);
          const uint c_swz = (c ^ r & 7u) << 1u;
          a_lds[r][c_swz] = a_prefetch[j][0];
          a_lds[r][c_swz + 1u] = a_prefetch[j][1];
        }
      }
      {
        const uint c = tid & 31u;
        [[unroll]] for (uint j = 0u; j < 4u; ++j) {
          const uint r = (tid >> 5u) + (j << 4u);
          const uint c_swz = (c ^ r & 31u) << 1u;
          b_lds[r][c_swz] = b_prefetch[j][0];
          b_lds[r][c_swz + 1u] = b_prefetch[j][1];
        }
      }
      barrier();
    }
  }
  const uint c_r_base = block_row + ((tid >> 7u) << 6u) + (tid & 15u);
  const uint c_c_base =
      block_col + (((tid >> 5u) & 3u) << 6u) + (((tid & 31u) >> 4u) << 3u);
  const f16vec4 exp_coef = f16vec4(-2.455078125hf);
  const f16vec4 one = f16vec4(1.0hf);
  [[unroll]] for (uint l = 0u; l < 4u; ++l) {
    const uint col_vec4_idx = (c_c_base + (l << 4u)) >> 2u;
    const f16vec4 bias0 = buffer_bias[col_vec4_idx];
    const f16vec4 bias1 = buffer_bias[col_vec4_idx + 1u];
    [[unroll]] for (uint e = 0u; e < 4u; ++e) {
      const uint row_idx = c_r_base + (e << 4u);
      const uint c_row_offset = row_idx * 2432u;
      const MatOut d = MatOut(c_frag[e][l]);
      const f16vec4 h0 = f16vec4(d[0], d[1], d[2], d[3]) + bias0;
      const f16vec4 h1 = f16vec4(d[4], d[5], d[6], d[7]) + bias1;
      const f16vec4 r0 = one / (exp2(h0 * exp_coef) + one);
      const f16vec4 r1 = one / (exp2(h1 * exp_coef) + one);
      buffer_c[c_row_offset + col_vec4_idx] = h0 * r0;
      buffer_c[c_row_offset + col_vec4_idx + 1u] = h1 * r1;
    }
  }
}