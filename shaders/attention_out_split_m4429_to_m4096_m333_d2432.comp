#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer In {
  f16vec4 buffer_in[];
};

layout(std430, set = 0, binding = 1) writeonly restrict buffer Out4096 {
  f16vec4 buffer_out_4096[];
};

layout(std430, set = 0, binding = 2) writeonly restrict buffer Out333 {
  f16vec4 buffer_out_333[];
};

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint wgid = gl_WorkGroupID.x;
  const uint gid = wgid * 256u + tid;
  const uint ELEMENTS_4096 = 2490368u;
  const uint ELEMENTS_TOTAL = 2692832u;
  if (gid < ELEMENTS_4096) {
    buffer_out_4096[gid] = buffer_in[gid];
  } else if (gid < ELEMENTS_TOTAL) {
    buffer_out_333[gid - ELEMENTS_4096] = buffer_in[gid];
  }
}