#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer A {
  f16vec4 buffer_a[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer bias {
  f16vec4 buffer_bias[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

shared f16vec4 c_lds[608];
shared vec4 wave_sums[8][33];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint stream_id = gl_WorkGroupID.y;
  c_lds[tid] = buffer_a[tid];
  c_lds[tid + 256u] = buffer_a[tid + 256u];
  if (tid < 96u) {
    c_lds[tid + 512u] = buffer_a[tid + 512u];
  }
  const uint n_tid = tid & 31u;
  const uint k_tid = tid >> 5u;
  const uint wg_col_base = gl_WorkGroupID.x << 5u;
  const uint col_vec4_idx = wg_col_base + n_tid;
  vec4 acc = vec4(0.0f);
  uint b_idx = stream_id * 8871936u + (k_tid << 2u) * 3648u + col_vec4_idx;
  barrier();
  [[unroll]] for (uint i = 0u; i < 76u; ++i) {
    const uint k_vec4_idx = (i << 3u) + k_tid;
    const vec4 a_val = vec4(c_lds[k_vec4_idx]);
    const vec4 b0 = vec4(buffer_b[b_idx]);
    const vec4 b1 = vec4(buffer_b[b_idx + 3648u]);
    const vec4 b2 = vec4(buffer_b[b_idx + 7296u]);
    const vec4 b3 = vec4(buffer_b[b_idx + 10944u]);
    acc = fma(vec4(a_val.x), b0, acc);
    acc = fma(vec4(a_val.y), b1, acc);
    acc = fma(vec4(a_val.z), b2, acc);
    acc = fma(vec4(a_val.w), b3, acc);
    b_idx += 116736u;
  }
  wave_sums[k_tid][n_tid] = acc;
  barrier();
  const uint wave_id = tid & 7u;
  const uint col_id = tid >> 3u;
  vec4 block_sum = wave_sums[wave_id][col_id];
  block_sum += subgroupShuffleDown(block_sum, 4u);
  block_sum += subgroupShuffleDown(block_sum, 2u);
  block_sum += subgroupShuffleDown(block_sum, 1u);
  if (wave_id == 0u) {
    const uint out_col_idx = stream_id * 3648u + wg_col_base + col_id;
    const vec4 b = vec4(buffer_bias[out_col_idx]);
    buffer_c[out_col_idx] = f16vec4(block_sum + b);
  }
}