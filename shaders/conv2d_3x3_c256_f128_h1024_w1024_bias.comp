#version 460

#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require

const uint TILE_M = 16;
const uint TILE_N = 16;
const uint TILE_K = 16;

#define MatA coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_K, gl_MatrixUseB>
#define MatB coopmat<float16_t, gl_ScopeSubgroup, TILE_K, TILE_N, gl_MatrixUseA>
#define MatAcc                                                                 \
  coopmat<float, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>
#define MatOut                                                                 \
  coopmat<float16_t, gl_ScopeSubgroup, TILE_M, TILE_N, gl_MatrixUseAccumulator>

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly restrict buffer A {
  f16vec4 buffer_a[];
};

layout(std430, set = 0, binding = 1) readonly restrict buffer B {
  f16vec4 buffer_b[];
};

layout(std430, set = 0, binding = 2) readonly restrict buffer Bias {
  f16vec4 buffer_bias[];
};

layout(std430, set = 0, binding = 3) writeonly restrict buffer C {
  f16vec4 buffer_c[];
};

shared f16vec4 a_lds[64][8];
shared f16vec4 b_lds[32][32];

void main() {
  const uint tid = gl_LocalInvocationID.x;
  const uint block_m_base = gl_WorkGroupID.x << 6u;
  f16vec4 a_prefetch[2][2];
  f16vec4 b_prefetch[4][2];
  MatA a_frag[2];
  MatB b_frag;
  MatAcc c_frag[2][4];
  [[unroll]] for (uint e = 0u; e < 2u; ++e) [[unroll]]
    for (uint l = 0u; l < 4u; ++l)
      c_frag[e][l] = MatAcc(0.0);
  uint n_dy = 0u;
  uint n_dx = 0u;
  uint n_c_chunk = 0u;
  [[unroll]] for (uint i = 0u; i < 2u; ++i) {
    const uint r = (tid >> 2u) + (i << 5u);
    const uint global_m = block_m_base + r;
    const uint h = global_m >> 10u;
    const uint w = global_m & 1023u;
    const int h_in = int(h) - 1;
    const int w_in = int(w) - 1;
    const uint c_in_v4 = (tid & 3u) << 1u;
    if (h_in >= 0 && h_in < 1024 && w_in >= 0 && w_in < 1024) {
      const uint a_off =
          ((uint(h_in) << 10u) + uint(w_in) << 6u) + c_in_v4;
      a_prefetch[i][0] = buffer_a[a_off];
      a_prefetch[i][1] = buffer_a[a_off + 1u];
    } else {
      a_prefetch[i][0] = f16vec4(0.0hf);
      a_prefetch[i][1] = f16vec4(0.0hf);
    }
  }
  const uint r_b = tid >> 2u;
  const uint pair_idx = (tid & 3u) << 2u;
  const uint b_off_init = (r_b << 5u) + (pair_idx << 1u);
  [[unroll]] for (uint k = 0u; k < 4u; ++k) {
    b_prefetch[k][0] = buffer_b[b_off_init + (k << 1u)];
    b_prefetch[k][1] = buffer_b[b_off_init + (k << 1u) + 1u];
  }
  [[unroll]] for (uint i = 0u; i < 2u; ++i) {
    const uint r = (tid >> 2u) + (i << 5u);
    const uint c_swz = (tid & 3u ^ r & 3u) << 1u;
    a_lds[r][c_swz] = a_prefetch[i][0];
    a_lds[r][c_swz + 1u] = a_prefetch[i][1];
  }
  [[unroll]] for (uint k = 0u; k < 4u; ++k) {
    const uint current_pair = pair_idx + k;
    const uint c_swz = (current_pair ^ r_b & 7u) << 1u;
    b_lds[r_b][c_swz] = b_prefetch[k][0];
    b_lds[r_b][c_swz + 1u] = b_prefetch[k][1];
  }
  barrier();
  for (uint chunk = 0u; chunk < 72u; ++chunk) {
    const bool next = chunk + 1u < 72u;
    if (next) {
      const uint next_chunk = chunk + 1u;
      n_dy = next_chunk / 24u;
      n_dx = (next_chunk >> 3u) % 3u;
      n_c_chunk = (next_chunk & 7u) << 5u;
      [[unroll]] for (uint i = 0u; i < 2u; ++i) {
        const uint r = (tid >> 2u) + (i << 5u);
        const uint global_m = block_m_base + r;
        const uint h = global_m >> 10u;
        const uint w = global_m & 1023u;
        const int h_in = int(h) + int(n_dy) - 1;
        const int w_in = int(w) + int(n_dx) - 1;
        const uint c_in_v4 = (tid & 3u) << 1u;
        if (h_in >= 0 && h_in < 1024 && w_in >= 0 && w_in < 1024) {
          const uint a_off =
              ((uint(h_in) << 10u) + uint(w_in) << 6u) + (n_c_chunk >> 2u) +
              c_in_v4;
          a_prefetch[i][0] = buffer_a[a_off];
          a_prefetch[i][1] = buffer_a[a_off + 1u];
        } else {
          a_prefetch[i][0] = f16vec4(0.0hf);
          a_prefetch[i][1] = f16vec4(0.0hf);
        }
      }
      const uint c_in = n_c_chunk + r_b;
      const uint b_off =
          (((n_dy * 3u + n_dx) << 8u) + c_in << 5u) + (pair_idx << 1u);
      [[unroll]] for (uint k = 0u; k < 4u; ++k) {
        b_prefetch[k][0] = buffer_b[b_off + (k << 1u)];
        b_prefetch[k][1] = buffer_b[b_off + (k << 1u) + 1u];
      }
    }
    [[unroll]] for (uint j = 0u; j < 2u; ++j) {
      const uint k_offset = j << 4u;
      const uint c_base_a = j << 1u;
      [[unroll]] for (uint e = 0u; e < 2u; ++e) {
        const uint r = (tid & 32u) + (e << 4u) + (tid & 15u);
        const uint c0 = (c_base_a ^ r & 3u) << 1u;
        const uint c1 = (c_base_a + 1u ^ r & 3u) << 1u;
        const f16vec4 a0 = a_lds[r][c0];
        const f16vec4 a1 = a_lds[r][c0 + 1u];
        const f16vec4 a2 = a_lds[r][c1];
        const f16vec4 a3 = a_lds[r][c1 + 1u];
        a_frag[e][0] = a0.x;
        a_frag[e][1] = a0.y;
        a_frag[e][2] = a0.z;
        a_frag[e][3] = a0.w;
        a_frag[e][4] = a1.x;
        a_frag[e][5] = a1.y;
        a_frag[e][6] = a1.z;
        a_frag[e][7] = a1.w;
        a_frag[e][8] = a2.x;
        a_frag[e][9] = a2.y;
        a_frag[e][10] = a2.z;
        a_frag[e][11] = a2.w;
        a_frag[e][12] = a3.x;
        a_frag[e][13] = a3.y;
        a_frag[e][14] = a3.z;
        a_frag[e][15] = a3.w;
      }
      [[unroll]] for (uint l = 0u; l < 4u; ++l) {
        const uint r = k_offset + (tid & 15u);
        const uint c_b_pair = ((tid >> 3u) & 8u) + (l << 1u);
        const uint c0 = (c_b_pair ^ r & 7u) << 1u;
        const uint c1 = (c_b_pair + 1u ^ r & 7u) << 1u;
        const f16vec4 b0 = b_lds[r][c0];
        const f16vec4 b1 = b_lds[r][c0 + 1u];
        const f16vec4 b2 = b_lds[r][c1];
        const f16vec4 b3 = b_lds[r][c1 + 1u];
        b_frag[0] = b0.x;
        b_frag[1] = b0.y;
        b_frag[2] = b0.z;
        b_frag[3] = b0.w;
        b_frag[4] = b1.x;
        b_frag[5] = b1.y;
        b_frag[6] = b1.z;
        b_frag[7] = b1.w;
        b_frag[8] = b2.x;
        b_frag[9] = b2.y;
        b_frag[10] = b2.z;
        b_frag[11] = b2.w;
        b_frag[12] = b3.x;
        b_frag[13] = b3.y;
        b_frag[14] = b3.z;
        b_frag[15] = b3.w;
        [[unroll]] for (uint e = 0u; e < 2u; ++e)
          c_frag[e][l] = coopMatMulAdd(b_frag, a_frag[e], c_frag[e][l]);
      }
    }
    if (next) {
      barrier();
      [[unroll]] for (uint i = 0u; i < 2u; ++i) {
        const uint r = (tid >> 2u) + (i << 5u);
        const uint c_swz = (tid & 3u ^ r & 3u) << 1u;
        a_lds[r][c_swz] = a_prefetch[i][0];
        a_lds[r][c_swz + 1u] = a_prefetch[i][1];
      }
      [[unroll]] for (uint k = 0u; k < 4u; ++k) {
        const uint current_pair = pair_idx + k;
        const uint c_swz = (current_pair ^ r_b & 7u) << 1u;
        b_lds[r_b][c_swz] = b_prefetch[k][0];
        b_lds[r_b][c_swz + 1u] = b_prefetch[k][1];
      }
      barrier();
    }
  }
  const uint c_r_base = block_m_base + (tid & 32u) + (tid & 15u);
  const uint c_c_base = (tid & 64u) + ((tid >> 1u) & 8u);
  [[unroll]] for (uint l = 0u; l < 4u; ++l) {
    const uint col_vec4_idx = (c_c_base + (l << 4u)) >> 2u;
    const f16vec4 bias0 = buffer_bias[col_vec4_idx];
    const f16vec4 bias1 = buffer_bias[col_vec4_idx + 1u];
    [[unroll]] for (uint e = 0u; e < 2u; ++e) {
      const uint row_idx = c_r_base + (e << 4u);
      if (row_idx < 1048576u) {
        const uint c_idx = (row_idx << 5u) + col_vec4_idx;
        const MatOut d = MatOut(c_frag[e][l]);
        buffer_c[c_idx] = f16vec4(d[0], d[1], d[2], d[3]) + bias0;
        buffer_c[c_idx + 1u] = f16vec4(d[4], d[5], d[6], d[7]) + bias1;
      }
    }
  }
}